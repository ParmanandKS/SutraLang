<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SutraLang" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#BB86FC</item>
        <item name="colorPrimaryVariant">#3700B3</item>
        <item name="colorOnPrimary">#000000</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#03DAC6</item>
        <item name="colorSecondaryVariant">#03DAC6</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Default Font Family -->
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>

        <!-- Editor and Output Colors -->
        <item name="editorBackground">#1E1E1E</item>
        <item name="editorTextColor">#D4D4D4</item>
        <item name="editorHintColor">#808080</item>
        <item name="outputBackground">#000000</item>
        <item name="outputTextColor">#00FF00</item>
    </style>
</resources>